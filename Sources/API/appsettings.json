{
  "App": {
    "AppName": "Presentation builder",
    "HttpPort": 8080,
    "HttpsPort": 8081
  },
  "Kestrel": {
    "AddServerHeader": false
  },
  "AllowedHosts": "*",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Information",
      "Microsoft.AspNetCore.Routing.EndpointMiddleware": "Warning"
    },
    "ApplicationInsights": {
      "LogLevel": {
        "Default": "Information"
      }
    }
  },
  "ReverseProxy": {
    "Routes": {
      "ApiV1": {
        "ClusterId": "PresentationBuilderAPI",
        "Match": {
          "Path": "/api/v1/{**catchAll}"
        }
      },
      "ApiV2": {
        "ClusterId": "PresentationBuilderAPI",
        "Match": {
          "Path": "/api/v2/{**catchAll}"
        }
      },
      "SwaggerRoute": {
        "ClusterId": "PresentationBuilderAPI",
        "Match": {
          "Path": "/swagger/{**catchAll}"
        }
      }
    },
    "Clusters": {
      "PresentationBuilderAPI": {
        "Destinations": {
          "app": {
            "Address": "http://localhost:8081/"
          }
        },
        "HttpRequest": {
          "MaxRequestBodySize": 2147483648, // 2 GB
          "RequestTimeout": "00:15:00" //,
          //"Version": "2.0" 
        }
      }
    }
  },
  "AzureApp": {
    "ClientId": "",
    "TenantId": "",
    "ClientSecret": "",
    "SiteHost": "",
    "SitePath": "",
    "TemplatesFolderName": "",
    "ResultFolderName": "",
    "WebProxyAddress": "",
    "UseWebProxy": false
  },
  "AzureStorage": {
    "ConnectionString": "ADD the connection strung",
    "ContainerName": "presentation-files",
    "ResultContainerName": "result-storage",
    "MaxRetries": 5,
    "NetworkTimeout": 5
  },
  "ApplicationInsights": {
    "ConnectionString": "ADD the connection strung"
  }
  //"Logging": {
  //  "LogLevel": {
  //    "Default": "Information",
  //    "Microsoft.AspNetCore": "Warning"
  //  }
  //},
}
